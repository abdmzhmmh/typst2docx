# Cargo.lock

# Environment and secrets
.env
.env.*
!.env.example

# IDE and Editor configs
.vscode/
.idea/
*.iml
*.swp
*.swo
*~

# OS specific files
Thumbs.db
.DS_Store

# Local testing and conversion scratch output
*.docx
!fixtures/**/*.docx
scratch/


# Added by cargo

/target
